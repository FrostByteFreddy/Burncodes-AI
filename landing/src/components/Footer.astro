---
import { Button } from '@/components/ui/button';
import { content } from '@/content';
import { localePath, site, type Locale } from '@/site';

interface Props { lang: Locale; hideCta?: boolean }
const { lang, hideCta = false } = Astro.props;
const t = content[lang];
const links = [
  { href: localePath(lang, '/funktionen/'), label: t.nav.features },
  { href: localePath(lang, '/gemeinden/'), label: t.nav.municipalities },
  { href: localePath(lang, '/organisationen/'), label: t.nav.organisations },
  { href: localePath(lang, '/preise/'), label: t.nav.pricing },
  { href: localePath(lang, '/fragen/'), label: t.nav.faq },
];
---
<footer class="bg-indigo-brand text-white">
  {!hideCta && (
    <div class="wrap flex flex-wrap items-center justify-between gap-6 py-14">
      <p class="max-w-xl text-3xl leading-tight font-bold md:text-4xl">{t.footer.cta}</p>
      <Button as="a" href={site.signup} size="lg" variant="inverse" class="h-12 px-6 text-base">{t.footer.ctaButton}</Button>
    </div>
  )}
  <div class="border-t border-white/20">
    <div class="wrap grid gap-8 py-10 text-sm md:grid-cols-[2fr_1fr_1fr]">
      <div>
        <img src="/img/logo_white.svg" alt="Burncodes AI" width="58" height="36" />
        <p class="mt-3 max-w-xs text-on-brand-muted">{t.footer.tagline}</p>
      </div>
      <nav aria-label={t.footer.product}>
        <h2 class="font-bold">{t.footer.product}</h2>
        <ul class="mt-2 space-y-1.5">
          {links.map((l) => <li><a class="text-on-brand-muted hover:text-white hover:underline" href={l.href}>{l.label}</a></li>)}
          <li><a class="text-on-brand-muted hover:text-white hover:underline" href={site.dashboard}>{t.nav.login}</a></li>
        </ul>
      </nav>
      <nav aria-label={t.footer.legal}>
        <h2 class="font-bold">{t.footer.legal}</h2>
        <ul class="mt-2 space-y-1.5">
          <li><a class="text-on-brand-muted hover:text-white hover:underline" href="/impressum/">{t.footer.imprint}</a></li>
          <li><a class="text-on-brand-muted hover:text-white hover:underline" href="/datenschutz/">{t.footer.privacy}</a></li>
        </ul>
        {t.footer.legalNote && <p class="mt-3 text-xs text-on-brand-muted">{t.footer.legalNote}</p>}
      </nav>
    </div>
  </div>
</footer>
