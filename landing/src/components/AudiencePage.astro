---
import { ArrowRight } from '@lucide/vue';
import { Button } from '@/components/ui/button';
import PageHero from '@/components/PageHero.astro';
import Shot from '@/components/Shot.astro';
import { site, type Locale } from '@/site';

interface Props { lang: Locale; sample: string; a: { h1: string; lede: string; questionsTitle: string; questions: string[]; pointsTitle: string; points: string[][]; cta: string } }
const { a, lang, sample } = Astro.props;
---
<PageHero h1={a.h1} lede={a.lede}>
  <Button as="a" href={site.signup} size="lg" variant="inverse" class="mt-8 h-14 px-7 text-lg">{a.cta}<ArrowRight /></Button>
</PageHero>
<div class="bg-card">
  <section class="section">
    <div class="wrap grid items-start gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
      <div>
        <h2 class="h2">{a.questionsTitle}</h2>
        <ul class="mt-8 flex flex-col items-start gap-3">
          {a.questions.map((q) => <li class="rounded-2xl rounded-bl-sm bg-accent px-4 py-2.5 font-semibold text-accent-foreground">{q}</li>)}
        </ul>
      </div>
      <figure>
        <Shot lang={lang} name="calendar" alt={a.questionsTitle} width={1088} widths={[544, 800, 1088]} sizes="(min-width: 1024px) 40rem, 100vw" class="rounded-xl border shadow-lg shadow-foreground/5" />
        <figcaption class="mt-2 text-sm text-muted-foreground">{sample}</figcaption>
      </figure>
    </div>
  </section>
  <section class="section border-t">
    <div class="wrap">
      <h2 class="h2">{a.pointsTitle}</h2>
      <dl class="mt-8 grid gap-x-12 md:grid-cols-2">
        {a.points.map(([title, text]) => (
          <div class="border-t py-5">
            <dt class="text-lg font-bold">{title}</dt>
            <dd class="mt-1 text-muted-foreground">{text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</div>
