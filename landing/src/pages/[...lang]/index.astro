---
import { ArrowRight, CalendarPlus, ExternalLink } from '@lucide/vue';
import Base from '@/layouts/Base.astro';
import DemoChat from '@/components/DemoChat.vue';
import Faq from '@/components/Faq.vue';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { content } from '@/content';
import { langPaths, localePath, site, type Locale } from '@/site';

export const getStaticPaths = langPaths;
const lang = Astro.props.lang as Locale;
const t = content[lang];
const h = t.home;
const d = t.demo.tabs[0].items[0];
const topFaq = [t.faq.groups[0].items[0], t.faq.groups[1].items[0], t.faq.groups[2].items[0], t.faq.groups[1].items[2]];
const counts = [12, 7, 4];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Burncodes AI',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: new URL(localePath(lang), site.url).href,
  description: t.meta.home.description,
};
---
<Base lang={lang} title={t.meta.home.title} description={t.meta.home.description} path="/" jsonLd={jsonLd}>
  <!-- Hero: the example chat hangs over the lower edge of the indigo field -->
  <section class="bg-indigo-brand text-white">
    <div class="wrap grid items-end gap-10 pt-12 md:pt-20 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-14">
      <div class="lg:pb-24">
        <h1 class="text-5xl leading-[1.02] font-bold tracking-tight sm:text-6xl xl:text-7xl">{h.h1}</h1>
        <p class="lede mt-6 max-w-xl">{h.lede}</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button as="a" href={site.signup} size="lg" variant="inverse" class="h-12 px-6 text-base">{h.cta}</Button>
          <Button as="a" href={localePath(lang, '/funktionen/')} size="lg" variant="ghost" class="h-12 px-4 text-base text-white hover:bg-white/10 hover:text-white">{h.secondary}<ArrowRight /></Button>
        </div>
        <p class="mt-4 text-sm text-on-brand-muted">{h.ctaNote}</p>
      </div>
      <div class="-mb-24 text-foreground">
        <DemoChat client:visible tabs={t.demo.tabs} label={t.demo.label} pick={t.demo.pick} calendar={t.demo.calendar} />
      </div>
    </div>
  </section>

  <section class="section pt-40!">
    <div class="wrap grid gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-14">
      <h2 class="h2">{h.problemTitle}</h2>
      <p class="lede text-muted-foreground">{h.problemText}</p>
    </div>
  </section>

  <section class="section border-y bg-card">
    <div class="wrap">
      <h2 class="h2">{h.stepsTitle}</h2>
      <ol class="mt-10 grid gap-10 md:grid-cols-3">
        {h.steps.map((s, i) => (
          <li>
            <p class="text-6xl leading-none font-bold text-primary" aria-hidden="true">{i + 1}</p>
            <h3 class="mt-3 text-xl">{s.title}</h3>
            <p class="mt-2 text-muted-foreground">{s.text}</p>
            {i === 2 && (
              <code class="mt-4 block rounded-lg bg-foreground p-3 font-mono text-xs leading-relaxed break-all text-white">&lt;script src="https://ai.burn.codes/api/tenants/widget.js" data-tenant-id="…"&gt;&lt;/script&gt;</code>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="h2">{h.showTitle}</h2>
      <div class="mt-12 space-y-16 md:space-y-20">
        {h.show.map((s, i) => (
          <div class="grid items-center gap-8 md:grid-cols-2 md:gap-14">
            <div class:list={[i % 2 === 1 && 'md:order-2']}>
              <h3 class="text-2xl md:text-3xl">{s.title}</h3>
              <p class="mt-3 text-muted-foreground">{s.text}</p>
            </div>
            <div class="rounded-2xl border bg-card p-6 shadow-sm">
              <div class="mb-4"><Badge variant="secondary">{t.words.example}</Badge></div>
              {i === 0 && (
                <div class="rounded-2xl bg-muted px-4 py-3">
                  <p set:html={d.a} />
                  <p class="mt-2 inline-flex items-center gap-1 font-semibold text-primary"><ExternalLink class="size-4" aria-hidden="true" />{d.source}</p>
                </div>
              )}
              {i === 1 && (
                <div>
                  <p class="font-semibold">{d.calendar}</p>
                  <ul class="mt-3 flex flex-wrap gap-2">
                    {['Apple', 'Google', 'Outlook'].map((app) => (
                      <li class="inline-flex items-center gap-1.5 rounded-lg border px-3 py-2 text-sm font-semibold"><CalendarPlus class="size-4 text-primary" aria-hidden="true" />{app}</li>
                    ))}
                  </ul>
                </div>
              )}
              {i === 2 && (
                <div>
                  <p class="font-bold">{h.fragments.openTitle}</p>
                  <ul class="mt-2 divide-y">
                    {h.fragments.open.map((q, n) => (
                      <li class="flex items-baseline justify-between gap-4 py-2.5"><span>{q}</span><span class="shrink-0 text-sm text-muted-foreground">{counts[n]} {h.fragments.asked}</span></li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section border-t bg-card">
    <div class="wrap">
      <h2 class="h2">{h.audienceTitle}</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {h.audience.map((a) => (
          <Card>
            <CardHeader><CardTitle class="text-2xl font-bold">{a.title}</CardTitle></CardHeader>
            <CardContent>
              <p class="text-muted-foreground">{a.text}</p>
              <Button as="a" href={localePath(lang, a.href)} variant="outline" class="mt-5">{a.link}<ArrowRight /></Button>
            </CardContent>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid items-center gap-8 md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] md:gap-14">
      <div>
        <h2 class="h2">{h.pricingTitle}</h2>
        <p class="lede mt-4 text-muted-foreground">{h.pricingText}</p>
        <Button as="a" href={localePath(lang, '/preise/')} variant="outline" class="mt-6">{h.pricingLink}<ArrowRight /></Button>
      </div>
      <div class="md:text-right">
        <p class="text-5xl font-bold text-primary lg:text-6xl">{h.pricingFigure}</p>
        <p class="mt-2 text-muted-foreground">{h.pricingFigureLabel}</p>
      </div>
    </div>
  </section>

  <section class="section border-t bg-card">
    <div class="wrap grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <div>
        <h2 class="h2">{h.faqTitle}</h2>
        <a class="mt-3 inline-block font-semibold text-primary hover:underline" href={localePath(lang, '/fragen/')}>{h.faqLink}</a>
      </div>
      <Faq client:visible items={topFaq} />
    </div>
  </section>
</Base>
