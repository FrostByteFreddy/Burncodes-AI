---
import Base from '@/layouts/Base.astro';
import AudiencePage from '@/components/AudiencePage.astro';
import { content } from '@/content';
import { langPaths, type Locale } from '@/site';

export const getStaticPaths = langPaths;
const lang = Astro.props.lang as Locale;
const t = content[lang];
---
<Base lang={lang} title={t.meta.organisations.title} description={t.meta.organisations.description} path="/organisationen/">
  <AudiencePage a={t.audiences.organisations} />
</Base>
